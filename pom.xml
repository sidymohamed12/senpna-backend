<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.6</version>
		<relativePath />
	</parent>

	<groupId>ministere.sante</groupId>
	<artifactId>senpna</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>senpna-backand</name>
	<description>SEN PNA — Gestion de la chaine d'approvisionnement pharmaceutique</description>

	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer>
			<id>sidymohamed12</id>
			<name>Sidy Mohamed Saizonou</name>
			<email>mohamedsaizonou86@gmail.com</email>
			<roles>
				<role>developer</role>
			</roles>
		</developer>
	</developers>
	<scm>
		<connection />
		<developerConnection />
		<tag />
		<url />
	</scm>
	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<mapstruct.version>1.6.3</mapstruct.version>
		<lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
		<querydsl.version>5.1.0</querydsl.version>
		<jjwt.version>0.12.6</jjwt.version>
		<jacoco.version>0.8.12</jacoco.version>

		<!-- ══════════════════════════════════════
		     SONARCLOUD
		     ⚠️ À ADAPTER : remplacez par votre organisation et la clé
		     de projet réelles créées sur https://sonarcloud.io
		     (Sonar > Administration > ... ou lors de l'import du repo).
		     ══════════════════════════════════════ -->
		<!-- <sonar.organization>sidymohamed12</sonar.organization>
		<sonar.projectKey>sidymohamed12_senpna-backend</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url> -->

		<!-- ══════════════════════════════════════
		     SONARQUBE AUTO-HÉBERGÉ (Community Build)
		     Serveur local, atteint uniquement depuis la machine qui
		     héberge aussi le self-hosted GitHub Actions runner.
		     Pas de "sonar.organization" : ce paramètre est spécifique à
		     SonarCloud, il n'existe pas sur un serveur auto-hébergé.
		     ══════════════════════════════════════ -->
		<sonar.projectKey>senpna-backend</sonar.projectKey>
		<sonar.host.url>http://localhost:9000</sonar.host.url>
		<sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<!-- Exclut le code généré (QueryDSL Q*, MapStruct impl) et les DTO/entités du calcul de
		couverture -->
		<sonar.coverage.exclusions>
			**/generated-sources/**,
			**/Q*.java,
			**/*MapperImpl.java,
			**/config/**,
			**/*Application.java
		</sonar.coverage.exclusions>
		<sonar.java.source>21</sonar.java.source>
	</properties>

	<dependencies>

		<!-- ══════════════════════════════════════
		     SPRING BOOT STARTERS
		══════════════════════════════════════ -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- Web (REST controllers, multipart upload) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- JPA + Hibernate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Spring Security (JWT filter, @PreAuthorize) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<dependency>
			<groupId>com.google.api-client</groupId>
			<artifactId>google-api-client</artifactId>
			<version>2.4.0</version>
		</dependency>

		<!-- Redis — cache distribué + blacklist JWT -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!--
		  ✅ AJOUTÉ : commons-pool2 requis par LettucePoolingClientConfiguration dans RedisConfig.
		  Sans cette dépendance, le pool Lettuce ne se configure pas et l'app refuse de démarrer.
		-->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-pool2</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Actuator (health check, caches) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Mail (notifications SMTP) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- OpenAPI / Swagger (springdoc-openapi) -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.17</version>
		</dependency>

		<!-- ══════════════════════════════════════
		     JWT — JJWT (io.jsonwebtoken)
		     ✅ AJOUTÉ : était utilisé dans JwtService mais absent du POM.
		     - jjwt-api   : compile (interfaces publiques)
		     - jjwt-impl  : runtime (implémentation — ne pas compiler dessus)
		     - jjwt-jackson : runtime (sérialisation claims via Jackson)
		══════════════════════════════════════ -->

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- ══════════════════════════════════════
		     BASE DE DONNÉES
		══════════════════════════════════════ -->

		<!-- PostgreSQL Driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		<!-- Flyway — migrations SQL versionnées -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>


		<!-- ══════════════════════════════════════
		     QUERYDSL — filtres dynamiques JPA
		     classifier=jakarta obligatoire Spring Boot 3+/4
		══════════════════════════════════════ -->

		<dependency>
			<groupId>com.querydsl</groupId>
			<artifactId>querydsl-jpa</artifactId>
			<version>${querydsl.version}</version>
			<classifier>jakarta</classifier>
		</dependency>

		<!-- ══════════════════════════════════════
		     JOOQ — requêtes analytiques dashboard
		     Boot 4.1 gère jOOQ 3.20+ (requiert Java 21)
		══════════════════════════════════════ -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jooq</artifactId>
		</dependency>

		<!-- ══════════════════════════════════════
		     LOMBOK & MAPSTRUCT
		══════════════════════════════════════ -->

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>


		<!-- ══════════════════════════════════════
		     STOCKAGE OBJET
		══════════════════════════════════════ -->

		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>2.25.60</version>
		</dependency>

		<!-- ══════════════════════════════════════
		     TESTS
		══════════════════════════════════════ -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  ✅ MODIFIÉ : spring-security-test seul → spring-boot-starter-security-test
		  Spring Boot 4 modularise les starters. Le test-starter de sécurité
		  apporte spring-security-test + les auto-configurations de test associées.
		  Sans ça, @WithMockUser et MockMvc security peuvent ne pas fonctionner.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  H2 pour le profil test (application-test.yml utilise H2 in-memory).
		  Sans H2 sur le classpath test, les tests d'intégration JPA échouent
		  avec "No suitable driver found for jdbc:h2:mem:...".
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Mockito (tests unitaires des Use Cases) -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<!-- Tests unitaires : exclut le tag "integration" -->
				<configuration>
					<excludedGroups>integration</excludedGroups>
				</configuration>
			</plugin>

			<!-- ══════════════════════════════════════
			     JACOCO — couverture de code
			     prepare-agent : instrumente les classes avant l'exécution des tests
			     report        : génère target/site/jacoco/jacoco.xml, consommé par SonarCloud
			     ══════════════════════════════════════ -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-prepare-agent-integration</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
							<goal>report-integration</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<!-- Tests d'intégration : uniquement le tag "integration" -->
				<configuration>
					<groups>integration</groups>
					<!--
					  ✅ AJOUTÉ : aucun application.yml par défaut n'existe (seulement
					  application-{profile}.yml), donc sans profil actif, le contexte
					  Spring des tests @SpringBootTest ne trouve aucune configuration.
					  On force explicitement le profil "test" (H2 in-memory, pas
					  d'infra externe requise) pour que `mvn verify` soit reproductible
					  partout (poste local, CI) sans dépendre d'une variable d'env.
					-->
					<systemPropertyVariables>
						<spring.profiles.active>test</spring.profiles.active>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Spring Boot executable JAR avec layers -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Exclut Lombok du JAR final (provided) -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
					<!--
					  ✅ MODIFIÉ : layertools supprimé en Boot 4.1.
					  Remplacé par le mode 'tools' natif.
					  Dans les Dockerfiles : java -Djarmode=tools -jar app.jar extract
					  (au lieu de java -Djarmode=layertools ...)
					-->
					<layers>
						<enabled>true</enabled>
					</layers>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>21</source>
					<target>21</target>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>${lombok-mapstruct-binding.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
						<!--
						  ✅ querydsl-apt uniquement ici en annotationProcessorPaths.
						  Supprimé des <dependencies> pour éviter le double enregistrement APT
						  qui cause "Attempt to recreate a file for type Q*".
						-->
						<path>
							<groupId>com.querydsl</groupId>
							<artifactId>querydsl-apt</artifactId>
							<version>${querydsl.version}</version>
							<classifier>jakarta</classifier>
						</path>
						<path>
							<groupId>org.hibernate.orm</groupId>
							<artifactId>hibernate-jpamodelgen</artifactId>
							<version>7.0.9.Final</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs>
						<arg>-Amapstruct.defaultComponentModel=spring</arg>
					</compilerArgs>
				</configuration>
			</plugin>

		</plugins>
	</build>

</project>
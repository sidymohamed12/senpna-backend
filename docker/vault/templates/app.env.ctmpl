{{- with secret "secret/data/senpna/app" }}
SERVER_PORT="{{ .Data.data.server_port }}"

DB_URL="{{ .Data.data.db_url }}"
DB_USERNAME="{{ .Data.data.db_username }}"
DB_PASSWORD="{{ .Data.data.db_password }}"

REDIS_HOST="{{ .Data.data.redis_host }}"
REDIS_PORT="{{ .Data.data.redis_port }}"
REDIS_PASSWORD="{{ .Data.data.redis_password }}"
REDIS_SSL_ENABLED="{{ .Data.data.redis_ssl_enabled }}"

JWT_SECRET="{{ .Data.data.jwt_secret }}"
JWT_ACCESS_TTL="{{ .Data.data.jwt_access_ttl }}"
JWT_REFRESH_TTL="{{ .Data.data.jwt_refresh_ttl }}"

CORS_ALLOWED_ORIGINS="{{ .Data.data.cors_allowed_origins }}"

RATE_LIMIT_AUTH="{{ .Data.data.rate_limit_auth }}"
RATE_LIMIT_AUTH_WINDOW="{{ .Data.data.rate_limit_auth_window }}"
RATE_LIMIT_API="{{ .Data.data.rate_limit_api }}"
RATE_LIMIT_API_WINDOW="{{ .Data.data.rate_limit_api_window }}"

MAIL_HOST="{{ .Data.data.mail_host }}"
MAIL_PORT="{{ .Data.data.mail_port }}"
MAIL_USERNAME="{{ .Data.data.mail_username }}"
MAIL_PASSWORD="{{ .Data.data.mail_password }}"
MAIL_FROM="{{ .Data.data.mail_from }}"
MAIL_FROM_NAME="{{ .Data.data.mail_from_name }}"

STORAGE_PROVIDER="{{ .Data.data.storage_provider }}"
STORAGE_R2_ACCOUNT_ID="{{ .Data.data.storage_r2_account_id }}"
STORAGE_R2_ACCESS_KEY="{{ .Data.data.storage_r2_access_key }}"
STORAGE_R2_SECRET_KEY="{{ .Data.data.storage_r2_secret_key }}"
STORAGE_R2_PUBLIC_URL="{{ .Data.data.storage_r2_public_url }}"
STORAGE_BUCKET="{{ .Data.data.storage_bucket }}"

CACHE_MEDICAMENT_TTL="{{ .Data.data.cache_medicament_ttl }}"
CACHE_LOT_TTL="{{ .Data.data.cache_lot_ttl }}"
CACHE_STOCK_TTL="{{ .Data.data.cache_stock_ttl }}"
CACHE_MOUVEMENT_TTL="{{ .Data.data.cache_mouvement_ttl }}"
CACHE_USER_TTL="{{ .Data.data.cache_user_ttl }}"
CACHE_CATALOGUE_TTL="{{ .Data.data.cache_catalogue_ttl }}"
CACHE_ACTUALITE_TTL="{{ .Data.data.cache_actualite_ttl }}"
CACHE_PROJET_TTL="{{ .Data.data.cache_projet_ttl }}"
{{- end }}

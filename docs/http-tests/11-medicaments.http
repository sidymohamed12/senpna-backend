Content-Type: application/json

{
  "nomCommercial": "Quinine nouvelle formule",
  "dci": "Quinine",
  "dosage": "300 mg",
  "formeId": "{{formeComprimeId}}",
  "familleId": "{{familleAntalgiqueId}}",

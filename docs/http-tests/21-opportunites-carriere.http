### 15. PUT /api/opportunites/{id} — modifier une offre existante (remplace tout le contenu)
PUT {{baseUrl}}/api/opportunites/{{offreStageBrouillonId}}
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "titre": "Stage — appui à la digitalisation des inventaires (mis à jour)",
  "nomEntreprise": "Pharmacie Nationale d'Approvisionnement (PNA)",
  "description": "Description mise à jour du stage, avec un périmètre légèrement élargi.",
  "ficheDePosteUrl": "https://cdn.senpna.sn/fiches-de-poste/stage-digitalisation-inventaires.jpg",
  "lieu": "Saint-Louis, Sénégal",
  "typeContrat": "STAGE",
  "dateDebut": "2027-03-01",
  "dateLimiteCandidature": "2027-01-31",
  "emailContact": "stages@senpna.sn"
}



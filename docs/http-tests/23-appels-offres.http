Authorization: Bearer {{loginFournisseur2.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "commentaire": "Meilleur prix du marché.",
  "lignes": [
    { "ligneAppelOffreId": "{{creerAO.response.body.$.results.lignes[0].id}}", "prixUnitaire": 22, "delaiLivraisonJours": 20 },
    { "ligneAppelOffreId": "{{creerAO.response.body.$.results.lignes[1].id}}", "prixUnitaire": 16, "delaiLivraisonJours": 20 }
  ]
}



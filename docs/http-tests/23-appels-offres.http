### ══════════════════════════════════════════════════════════════════
### D. Soumission d'offres (espace fournisseur)
### ══════════════════════════════════════════════════════════════════

### 26. POST /api/fournisseur/appels-offres/{id}/offres — Pharma Sénégal soumet une offre sur les 2 lignes
# @name soumettreOffre1
POST {{baseUrl}}/api/fournisseur/appels-offres/{{creerAO.response.body.$.results.id}}/offres
Authorization: Bearer {{loginFournisseur1.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "commentaire": "Offre compétitive, livraison sous 15 jours.",
  "lignes": [
    { "ligneAppelOffreId": "{{creerAO.response.body.$.results.lignes[0].id}}", "prixUnitaire": 25, "delaiLivraisonJours": 15 },
    { "ligneAppelOffreId": "{{creerAO.response.body.$.results.lignes[1].id}}", "prixUnitaire": 18, "delaiLivraisonJours": 15 }
  ]
}


### 27. POST .../offres — cas d'erreur, ce fournisseur a déjà une offre SOUMISE sur cet AO (409 attendu)
POST {{baseUrl}}/api/fournisseur/appels-offres/{{creerAO.response.body.$.results.id}}/offres
Authorization: Bearer {{loginFournisseur1.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "lignes": [
    { "ligneAppelOffreId": "{{creerAO.response.body.$.results.lignes[0].id}}", "prixUnitaire": 20, "delaiLivraisonJours": 10 }
  ]
}



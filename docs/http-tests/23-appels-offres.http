Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}


### 47. PATCH .../cloturer — cas d'erreur, déjà clôturé (422 attendu)
PATCH {{baseUrl}}/api/appels-offres/{{creerAO.response.body.$.results.id}}/cloturer
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}


### 48. PATCH /api/appels-offres/{id}/attribuer — CLOTURE → ATTRIBUE, statue sur l'offre retenue
PATCH {{baseUrl}}/api/appels-offres/{{creerAO.response.body.$.results.id}}/attribuer
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "offresRetenuesIds": ["{{soumettreOffre1.response.body.$.results.id}}"],
  "offresRejeteesIds": []
}


### 49. PATCH .../attribuer — cas d'erreur, déjà attribué (422 attendu)
PATCH {{baseUrl}}/api/appels-offres/{{creerAO.response.body.$.results.id}}/attribuer
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "offresRetenuesIds": [],
  "offresRejeteesIds": []
}


### 50. PATCH /api/appels-offres/{id}/annuler — cas d'erreur, un AO attribué ne peut plus être annulé (422 attendu)
PATCH {{baseUrl}}/api/appels-offres/{{creerAO.response.body.$.results.id}}/annuler
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}


### 51. PATCH /api/appels-offres/{id}/annuler — cas nominal, annule l'AO resté en BROUILLON
PATCH {{baseUrl}}/api/appels-offres/{{creerAoBrouillon.response.body.$.results.id}}/annuler
Authorization: Bearer {{loginGestionnairePna.response.body.$.results.accessToken}}


### 52. GET /api/appels-offres — filtré par statut=ATTRIBUE, vérifie l'état final
GET {{baseUrl}}/api/appels-offres?statut=ATTRIBUE
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "aissatou.sow@sante.gouv.sn",
  "password": "{{password}}"
}


### 0d. Login — MAGASINIER_PNA (pour les tests de rôle insuffisant)
# @name loginMagasinierPna
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ousmane.kane@sante.gouv.sn",
  "password": "{{password}}"
}


### 0e. Login — ADMIN_PRA (pour les tests de rôle insuffisant : la PRA ne gère pas les appels d'offres)
# @name loginAdminPra
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "abdoulaye.ndoye@sante.gouv.sn",
  "password": "{{password}}"
}


### ── Provisionnement des deux comptes espace fournisseur ─────────────
### Un compte FOURNISSEUR est un compte utilisateur normal (table users)
### affecté à un fournisseur — cf. CreateUserUseCaseImpl. Réservé aux
### acteurs nationaux (ADMIN_PNA) ; email unique via {{$timestamp}} pour
### pouvoir rejouer ce fichier plusieurs fois sans 409.

### 0f. POST /api/users — crée le compte espace fournisseur de Pharma Sénégal
# @name creerCompteFournisseur1
POST {{baseUrl}}/api/users
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "nom": "Pharma Sénégal",
  "prenom": "Espace Fournisseur",
  "email": "fournisseur1.{{$timestamp}}@pharma-senegal.sn",
  "roleIds": ["{{roleFournisseurId}}"],
  "fournisseurId": "{{fournisseurPharmaSenegalId}}"
}


### 0g. Login — espace fournisseur Pharma Sénégal, avec le mot de passe temporaire reçu ci-dessus
# @name loginFournisseur1
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{creerCompteFournisseur1.response.body.$.results.user.email}}",
  "password": "{{creerCompteFournisseur1.response.body.$.results.motDePasseTemporaire}}"
}


### 0h. POST /api/users — crée le compte espace fournisseur de MedSupply
# @name creerCompteFournisseur2
POST {{baseUrl}}/api/users
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "nom": "MedSupply",
  "prenom": "Espace Fournisseur",
  "email": "fournisseur2.{{$timestamp}}@medsupply.sn",
  "roleIds": ["{{roleFournisseurId}}"],
  "fournisseurId": "{{fournisseurMedSupplyId}}"
}


### 0i. Login — espace fournisseur MedSupply
# @name loginFournisseur2
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{creerCompteFournisseur2.response.body.$.results.user.email}}",
  "password": "{{creerCompteFournisseur2.response.body.$.results.motDePasseTemporaire}}"
}


### 0j. POST /api/users — cas d'erreur, ADMIN_PRA ne peut pas créer de compte espace fournisseur (403 attendu)
POST {{baseUrl}}/api/users
Authorization: Bearer {{loginAdminPra.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "nom": "Ne devrait pas",
  "prenom": "être créé",
  "email": "refuse.{{$timestamp}}@test.sn",
  "roleIds": ["{{roleFournisseurId}}"],
  "fournisseurId": "{{fournisseurPharmaSenegalId}}"
}


### ══════════════════════════════════════════════════════════════════
### A. Création d'un appel d'offres (PNA)
### ══════════════════════════════════════════════════════════════════

### 1. POST /api/appels-offres — création nominale, deux lignes (BROUILLON attendu)
# @name creerAO
POST {{baseUrl}}/api/appels-offres
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "reference": "AO-TEST-{{$timestamp}}",
  "objet": "Achat Amoxicilline et Paracétamol — test HTTP",
  "dateCloture": "2027-01-31",
  "lignes": [
    { "medicamentId": "{{medicamentAmoxicillineId}}", "designation": "Amoxicilline 500 mg", "quantiteEstimee": 100000, "uniteBase": "Comprimé" },
    { "medicamentId": "{{medicamentParacetamolId}}", "designation": "Paracétamol 500 mg", "quantiteEstimee": 200000, "uniteBase": "Comprimé" }
  ]
}


### 2. POST /api/appels-offres — cas limite, une seule ligne (créé par GESTIONNAIRE_PNA)
# @name creerAoBrouillon
POST {{baseUrl}}/api/appels-offres
Authorization: Bearer {{loginGestionnairePna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "reference": "AO-BROUILLON-{{$timestamp}}",
  "objet": "Appel d'offres qui restera en brouillon (tests de visibilité)",
  "dateCloture": "2027-02-28",
  "lignes": [
    { "medicamentId": "{{medicamentParacetamolId}}", "designation": "Paracétamol 500 mg", "quantiteEstimee": 50000, "uniteBase": "Comprimé" }
  ]
}


### 3. POST /api/appels-offres — cas d'erreur, aucune ligne (400 attendu)
POST {{baseUrl}}/api/appels-offres
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "reference": "AO-SANS-LIGNE",
  "objet": "Sans ligne",
  "dateCloture": "2027-01-31",
  "lignes": []
}


### 4. POST /api/appels-offres — cas d'erreur, référence manquante (400 attendu)
POST {{baseUrl}}/api/appels-offres
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "objet": "Sans référence",
  "dateCloture": "2027-01-31",
  "lignes": [
    { "medicamentId": "{{medicamentAmoxicillineId}}", "designation": "Amoxicilline", "quantiteEstimee": 10, "uniteBase": "Comprimé" }
  ]
}


### 5. POST /api/appels-offres — cas d'erreur, date de clôture non future (400 attendu — @Future)
POST {{baseUrl}}/api/appels-offres
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "reference": "AO-DATE-PASSEE",
  "objet": "Date de clôture passée",
  "dateCloture": "2020-01-01",
  "lignes": [
    { "medicamentId": "{{medicamentAmoxicillineId}}", "designation": "Amoxicilline", "quantiteEstimee": 10, "uniteBase": "Comprimé" }
  ]
}


### 6. POST /api/appels-offres — cas d'erreur, quantité estimée négative (400 attendu)
POST {{baseUrl}}/api/appels-offres
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "reference": "AO-QUANTITE-NEGATIVE",
  "objet": "Quantité négative",
  "dateCloture": "2027-01-31",
  "lignes": [
    { "medicamentId": "{{medicamentAmoxicillineId}}", "designation": "Amoxicilline", "quantiteEstimee": -5, "uniteBase": "Comprimé" }
  ]
}


### 7. POST /api/appels-offres — cas d'erreur, référence déjà utilisée (409 attendu)

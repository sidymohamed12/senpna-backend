  "dateLivraisonEstimee": "2027-01-05",
  "lignes": [
    { "ligneId": "{{creerCommande.response.body.$.results.lignes[0].id}}", "numeroLot": "LOT-AMOX-{{$timestamp}}", "dateFabrication": "2026-01-01", "dateExpiration": "2028-01-01", "certificatAnalyseUrl": "https://cdn.senpna.sn/certificats/lot-amox.pdf", "quantiteExpediee": 1000 },
    { "ligneId": "{{creerCommande.response.body.$.results.lignes[1].id}}", "numeroLot": "LOT-PARA-{{$timestamp}}", "dateFabrication": "2026-01-01", "dateExpiration": "2028-01-01", "certificatAnalyseUrl": "https://cdn.senpna.sn/certificats/lot-para.pdf", "quantiteExpediee": 2000 }
  ]
}



### 14. PUT /api/conditionnements/{id} — modifier un conditionnement existant (renommer + reconvertir)
PUT {{baseUrl}}/api/conditionnements/{{conditionnementAmoxBoiteId}}
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "nom": "Boîte de 30",
  "niveau": 2,
  "quantiteUniteBase": 30,
  "estUniteBase": false
}


### 15. PUT /api/conditionnements/{id} — cas d'erreur, nom vide (400 attendu)
PUT {{baseUrl}}/api/conditionnements/{{conditionnementAmoxBoiteId}}
Authorization: Bearer {{loginAdminPna.response.body.$.results.accessToken}}
Content-Type: application/json

{
  "nom": "",
  "niveau": 2,
  "quantiteUniteBase": 20,
  "estUniteBase": false
}


